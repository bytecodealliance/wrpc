package wrpc:rpc@0.2.0;

interface error {
    /// A resource which represents some error information.
    ///
    /// The only method provided by this resource is `to-debug-string`,
    /// which provides some human-readable information about the error.
    resource error {
        /// Returns a string that is suitable to assist humans in debugging
        /// this error.
        ///
        /// WARNING: The returned string should not be consumed mechanically!
        /// It may change across platforms, hosts, or other implementation
        /// details. Parsing this string is a major platform-compatibility
        /// hazard.
        to-debug-string: func() -> string;
    }
}

interface context {
    resource context {
        default: static func() -> context;
    }
}

/// The data of an invocation in each direction forms a tree of channels. The
/// root channel carries the encoded value, and each async value (stream or
/// future) nested within it is carried by a separate channel. A channel is
/// identified by its position: the sequence of indices into nested values
/// leading to the async value, as defined by the wRPC specification
/// (https://github.com/bytecodealliance/wrpc/blob/main/SPEC.md#indexing).
/// The parameters and results are indexed as tuples, record fields and tuple
/// members by their order of declaration, and list and stream elements by
/// their concrete index. The payload of an option, result, variant or future
/// has the position of the value containing it.
///
/// The positions of the async values to be received are declared when the
/// invocation is created, as sequences of indices where `none` stands for any
/// element of a list or stream. The positions of the async values to be sent
/// are not declared.
///
/// `index` returns the channel for the position at `path`, relative to the
/// position of the channel it is called on. The returned channel is
/// independent of the channel it is called on.
///
/// The data of a channel is taken by `read-via-stream` or `write-via-stream`,
/// which does not prevent indexing the channel. A value is sent before the
/// async values nested within it, so their positions are known once it is
/// read. A position is closed once its value is sent, or once the
/// `outgoing-channel` for it is dropped without taking its data. The outgoing
/// direction ends once all of its channels and the streams written to them
/// are dropped.
///
/// Data is received only while the streams taken from the incoming channels
/// are read, one frame at a time: a frame received for a position is held
/// until the stream of that position is read, which stalls all other
/// positions, so the streams of all declared positions must be read
/// concurrently. A frame received for a position, which was not declared or
/// is closed, fails the invocation, as does data received for a position,
/// whose stream was dropped before the position was closed, or whose channel
/// was dropped without taking its data.
///
/// Failures to transmit the invocation are returned by `invoke`, failures to
/// receive by the future returned by `read-via-stream` and failures to send
/// by `write-via-stream`.
interface transport {
    use error.{error};

    resource incoming-channel {
        /// Takes the data of this channel, returning a stream of the data
        /// received on its position and a future, which resolves once the
        /// peer closes the position, or to an error if receiving fails before.
        ///
        /// Traps if the data was already taken, or if the position is neither
        /// the root nor that of a declared async value.
        read-via-stream: func() -> tuple<stream<u8>, future<result<_, error>>>;

        /// Returns the channel for the position at `path`.
        ///
        /// Traps if `path` is empty, if the position is neither that of a
        /// declared async value nor a prefix of one, or if the channel for the
        /// position was already returned.
        index: func(path: list<u32>) -> incoming-channel;
    }

    resource outgoing-channel {
        /// Takes the data of this channel, writing `data` to its position and
        /// closing the position once `data` ends. Returns once the data is
        /// written, or an error if writing fails.
        ///
        /// Traps if the data was already taken.
        write-via-stream: async func(data: stream<u8>) -> result<_, error>;

        /// Returns the channel for the position at `path`.
        ///
        /// Traps if `path` is empty, or if the channel for the position was
        /// already returned. Writing to a position, which the peer has not
        /// declared, or closing it by dropping its channel, fails the
        /// invocation on the peer.
        index: func(path: list<u32>) -> outgoing-channel;
    }
}

interface invoker {
    use context.{context};
    use error.{error};
    use transport.{incoming-channel, outgoing-channel};

    /// Invoke a function, returning once the invocation is transmitted, or an
    /// error if transmitting it fails.
    ///
    /// `params` is the encoded parameter tuple, sent along with the invocation,
    /// which closes the root position. The async values within the parameters
    /// are written to the channels returned by `index` on the returned root
    /// `outgoing-channel`.
    ///
    /// The data of the returned root `incoming-channel` is the encoded result
    /// tuple. `paths` declares the positions of the async values within the
    /// results, which are read from the channels returned by `index` on it.
    /// The host may limit the total number of indices in `paths`, returning an
    /// error if they exceed it.
    invoke: async func(cx: context, instance: string, name: string, params: list<u8>, paths: list<list<option<u32>>>) -> result<tuple<outgoing-channel, incoming-channel>, error>;
}

world imports {
    import invoker;
}
