package wrpc-test:big-tuples;

interface to-test {
  type t17 = tuple<u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, string>;

  roundtrip: func(a: list<t17>) -> list<t17>;
  nested-future: func(a: tuple<u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, u8, future<u8>>) -> future<u8>;
  many-params: func(a0: u8, a1: u8, a2: u8, a3: u8, a4: u8, a5: u8, a6: u8, a7: u8, a8: u8, a9: u8, a10: u8, a11: u8, a12: u8, a13: u8, a14: u8, a15: u8, a16: string) -> string;
}

world test {
  export to-test;
}
world runner {
  import to-test;

  export run: func();
}
