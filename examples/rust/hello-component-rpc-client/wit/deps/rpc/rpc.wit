package wrpc:rpc@0.2.0;

interface error {
    /// A resource which represents some error information.
    ///
    /// The only method provided by this resource is `to-debug-string`,
    /// which provides some human-readable information about the error.
    resource error {
        /// Returns a string that is suitable to assist humans in debugging
        /// this error.
        ///
        /// WARNING: The returned string should not be consumed mechanically!
        /// It may change across platforms, hosts, or other implementation
        /// details. Parsing this string is a major platform-compatibility
        /// hazard.
        to-debug-string: func() -> string;
    }
}

interface context {
    resource context {
        default: static func() -> context;
    }
}

/// The data of an invocation in each direction forms a tree of channels. The
/// root channel carries the encoded value, and each async value (stream or
/// future) nested within it is carried by a separate channel. A channel is
/// identified by its position: the sequence of indices into nested values
/// leading to the async value, as defined by the wRPC specification
/// (https://github.com/bytecodealliance/wrpc/blob/main/SPEC.md#indexing).
/// The parameters and results are indexed as tuples, record fields and tuple
/// members by their order of declaration, and list and stream elements by
/// their concrete index. The payload of an option, result, variant or future
/// has the position of the value containing it, so a pending future's value is
/// carried by the channel at the future's position
/// (https://github.com/bytecodealliance/wrpc/blob/main/SPEC.md#futures).
///
/// The positions of the async values to be received are declared when the
/// invocation is created, as sequences of indices where `none` stands for any
/// element of a list or stream. The positions of the async values to be sent
/// are not declared.
///
/// `index` returns the channel for the position at `path`, relative to the
/// position of the channel it is called on. The returned channel is independent
/// of the channel it is called on: it remains valid after that channel is
/// dropped. An empty `path` always returns an error.
///
/// The data of a channel is taken by `read-via-stream` or `write-via-stream`.
/// Taking the data does not prevent indexing the channel, so the positions of
/// list and stream elements can be indexed once they are known from the data.
/// Dropping a channel does not affect data already taken from it. Dropping an
/// `incoming-channel` whose data has not been taken discards its data.
/// Dropping an `outgoing-channel` whose data has not been taken writes no data
/// to it.
///
/// Each direction of an invocation ends once all of its data has been sent,
/// which for the outgoing direction is once all of its channels have been
/// dropped and all data taken from them has been written. The end of a
/// direction closes all of its positions, and a single outgoing position can
/// be closed by `close`. Closing a position does not close the positions
/// nested in it. Positions need not be closed explicitly, since the end of the
/// data of a channel is determined by its encoded value, except for a pending
/// future without a payload: its position must be closed once it resolves,
/// either by `close` or by ending the outgoing direction.
///
/// Data received for a position is not buffered, so the peer is subject to
/// backpressure until it is read. Backpressure applies to all channels of the
/// invocation, so a position whose data is not being read, either because its
/// channel has not been returned yet or because its data has been taken but
/// is not being read, can stall all other positions, including the root. The
/// caller should therefore index nested positions as soon as they are known,
/// rather than first reading the entire data of the channel they are nested
/// in, and read the data taken from all channels concurrently.
///
/// Data received for a position whose data is not taken, whether because its
/// channel was dropped without taking it or because it was never returned, is
/// discarded and fails the invocation once all incoming channels of the
/// invocation have been dropped.
///
/// Failures of an invocation are reported by the future returned by `invoke`.
interface transport {
    use error.{error};

    resource incoming-channel {
        /// Takes the data of this channel, returning a stream of the data
        /// received on it and a future to signal the result of reading it.
        ///
        /// The stream ends once the position of this channel is closed, either
        /// by the peer or by the end of the incoming direction, which are not
        /// distinguished. The caller should drop the stream's readable end once
        /// it has read the end of the encoded value. Data not read from the
        /// stream before its readable end is dropped is discarded, which fails
        /// the invocation.
        ///
        /// The future resolves once the position of this channel is closed: to
        /// an error if receiving fails or if unread data has been discarded,
        /// and to success otherwise. Dropping the returned future
        /// does not cancel the read.
        ///
        /// Returns an error if the data of this channel has already been taken,
        /// or if this channel is neither the root channel nor at the position
        /// of a declared async value.
        read-via-stream: func() -> result<tuple<stream<u8>, future<result<_, error>>>, error>;

        /// Returns the channel for the position at `path`.
        ///
        /// The resulting position may be that of a declared async value or a
        /// prefix of one, so that nested async values can be indexed
        /// incrementally. Returns an error if it is neither, or if it is that of
        /// a declared async value whose channel has already been returned for
        /// the invocation.
        index: func(path: list<u32>) -> result<incoming-channel, error>;
    }

    resource outgoing-channel {
        /// Takes the data of this channel, writing the given stream to it, and
        /// returns a future to signal the result of writing it.
        ///
        /// The caller should drop the stream's writable end once it has no more
        /// data to send, which does not close the position of this channel. The
        /// future then resolves to success once the entire contents of the
        /// stream have been accepted by the underlying transport for
        /// transmission. This does not indicate that the data has been sent, or
        /// that the peer has received or processed it.
        ///
        /// If writing fails, the stream's readable end is dropped and the future
        /// resolves to an error. Dropping the returned future does not cancel the
        /// write.
        ///
        /// Returns an error if the data of this channel has already been taken.
        write-via-stream: func(data: stream<u8>) -> result<future<result<_, error>>, error>;

        /// Returns the channel for the position at `path`.
        ///
        /// This does not check that the resulting position holds an async value,
        /// nor whether a channel for it has already been returned. Data written
        /// to a position, which the peer has not declared, fails the invocation
        /// on the peer. The data written to multiple channels for the same
        /// position is interleaved.
        index: func(path: list<u32>) -> result<outgoing-channel, error>;

        /// Closes the position of this channel, returning once that has been
        /// accepted by the underlying transport for transmission.
        ///
        /// No more data may be written to the position afterwards by any
        /// channel, so all writes of data to it must have completed before.
        /// Since the closed positions are not tracked, writing data to a closed
        /// position or closing it again fails the invocation on the peer.
        ///
        /// Returns an error if writing fails.
        close: async func() -> result<_, error>;
    }
}

interface invoker {
    use context.{context};
    use error.{error};
    use transport.{incoming-channel, outgoing-channel};

    /// Invoke a function.
    ///
    /// The invocation is transmitted asynchronously. Until the underlying
    /// transport is ready, the streams written to the returned outgoing
    /// channels are not read from.
    ///
    /// `params` is the beginning of the encoded parameter tuple, sent along with
    /// the invocation. The rest of it, if any, is written to the returned root
    /// `outgoing-channel` with `write-via-stream`. The async values within the
    /// parameters are written to the channels returned by `index` on it.
    ///
    /// The data of the returned root `incoming-channel` is the encoded result
    /// tuple. `paths` declares the positions of the async values within the
    /// results, which are read from the channels returned by `index` on it.
    ///
    /// The returned future resolves once the invocation has completed, which
    /// is once both of its directions have ended and all of its channels and
    /// the streams taken from them have been dropped. It resolves to an error
    /// if the invocation has failed at any point, including transmitting the
    /// invocation itself and after all `read-via-stream` and
    /// `write-via-stream` futures and `close` calls have completed, and to
    /// success otherwise. Dropping the returned future does not cancel the
    /// invocation.
    invoke: func(cx: context, instance: string, name: string, params: list<u8>, paths: list<list<option<u32>>>) -> tuple<outgoing-channel, incoming-channel, future<result<_, error>>>;
}

world imports {
    import invoker;
}
